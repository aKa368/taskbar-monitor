<UserControl x:Class="TaskbarMonitor.UI.AccountTaskbarContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:TaskbarMonitor.UI"
             Background="Transparent" ClipToBounds="True"
             SnapsToDevicePixels="True" UseLayoutRounding="True">
  <Grid Height="40" VerticalAlignment="Center" ClipToBounds="True">
    <ItemsControl ItemsSource="{Binding AccountPods}" ClipToBounds="True"
                  Margin="3,0,7,0" VerticalAlignment="Center" HorizontalContentAlignment="Stretch">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <ui:AdaptiveUniformPanel MaxRows="2" MinimumCellWidth="94" HorizontalGap="3" VerticalGap="2" PreferredSecondRowKey="Claude" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Background="#16000000" BorderBrush="#3DFFFFFF" BorderThickness="1"
                  CornerRadius="5" Padding="5,1" Height="18" ClipToBounds="True"
                  ToolTip="{Binding ToolTipText}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="{Binding Label}" Foreground="#B8C0CC" FontSize="10"
                         FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,5,0"
                         TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
              <TextBlock Text="{Binding ValueText}" Foreground="#F4F6F8"
                         FontSize="10" FontWeight="SemiBold" TextAlignment="Left"
                         MaxWidth="54" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</UserControl>
