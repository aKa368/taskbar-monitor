<UserControl x:Class="TaskbarMonitor.UI.AccountTaskbarContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:TaskbarMonitor.UI"
             Background="Transparent" ClipToBounds="False"
             FontFamily="{Binding FontFamily}" FontSize="{Binding FontSize}"
             SnapsToDevicePixels="True" UseLayoutRounding="True">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <ui:InvertedBooleanToVisibilityConverter x:Key="InvertedBoolToVis"/>
  </UserControl.Resources>
  <Grid VerticalAlignment="Center" ClipToBounds="False">
    <!-- Horizontal mode: Clean borderless layout matching Floating capsule -->
    <ItemsControl ItemsSource="{Binding AccountPods}" VerticalAlignment="Center"
                  HorizontalAlignment="{Binding AccountHorizontalAlignment}"
                  Visibility="{Binding DataContext.IsVertical, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InvertedBoolToVis}}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Background="Transparent" Padding="2,0" Margin="2,0"
                  MinWidth="{Binding MinWidth}"
                  Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}"
                  ToolTip="{Binding ToolTipText}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock Text="{Binding Label}" Foreground="{Binding StatusBrush}"
                         FontWeight="SemiBold" Margin="0,0,5,0" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding ValueText}" Foreground="#F0F4F8"
                         FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Vertical mode -->
    <ItemsControl ItemsSource="{Binding AccountPods}" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                  Visibility="{Binding DataContext.IsVertical, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><ui:AdaptiveUniformPanel MaxRows="10" MinimumCellWidth="48" HorizontalGap="2" VerticalGap="2" /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Background="Transparent" Padding="1,2"
                  Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}"
                  ToolTip="{Binding ToolTipText}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock Text="{Binding Line1}" Foreground="{Binding StatusBrush}" FontSize="8.5"
                         FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="NoWrap"/>
              <TextBlock Text="{Binding Line2}" Foreground="#F0F4F8" FontSize="8"
                         FontWeight="Normal" HorizontalAlignment="Center" TextWrapping="NoWrap"/>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</UserControl>
