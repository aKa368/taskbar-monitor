<Window x:Class="TaskbarMonitor.UI.FloatingMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:TaskbarMonitor.UI"
        Title="TaskbarMonitor Floating"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" WindowState="Normal"
        SizeToContent="WidthAndHeight" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{Binding FontFamily}" FontSize="{Binding FontSize}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <ui:InvertedBooleanToVisibilityConverter x:Key="InvertedBoolToVis"/>
    <ui:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVis"/>
  </Window.Resources>
  <Border x:Name="CapsuleBorder" BorderThickness="1" Cursor="SizeAll">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EB161922" Offset="0.0"/>
        <GradientStop Color="#E010131A" Offset="1.0"/>
      </LinearGradientBrush>
    </Border.Background>
    <Border.BorderBrush>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#45FFFFFF" Offset="0.0"/>
        <GradientStop Color="#18FFFFFF" Offset="1.0"/>
      </LinearGradientBrush>
    </Border.BorderBrush>
    <Border.Style>
      <Style TargetType="Border">
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Margin" Value="8"/>
        <Setter Property="Effect">
          <Setter.Value>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2.5" Opacity="0.45" Color="#000000" Direction="270"/>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsFloatingVertical}" Value="True">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="6,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Width" Value="80"/>
            <Setter Property="Effect">
              <Setter.Value>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.35" Color="#000000" Direction="270"/>
              </Setter.Value>
            </Setter>
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Border.Style>
    <Grid>
      <!-- Mini Game HUD mode: ultra-compact gaming stats (FPS, Ping, APU Temp) -->
      <StackPanel x:Name="MiniHudContainer" Orientation="Horizontal" VerticalAlignment="Center"
                  Visibility="{Binding IsMiniGameHud, Converter={StaticResource BoolToVis}}">
        <!-- Glowing Game Indicator Dot -->
        <Border Width="6" Height="6" CornerRadius="3" Background="#10B981" Margin="0,0,8,0" VerticalAlignment="Center">
          <Border.Effect>
            <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#10B981" Opacity="0.8"/>
          </Border.Effect>
        </Border>
        <TextBlock Text="{Binding MiniGameFpsText}" Foreground="#4ADE80" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center"/>
        <Border Width="1" Height="{Binding FontSize}" Background="#26FFFFFF" Margin="0,0,10,0" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding MiniGamePingText}" Foreground="#38BDF8" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center"/>
        <Border Width="1" Height="{Binding FontSize}" Background="#26FFFFFF" Margin="0,0,10,0" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding MiniGameTempText}" Foreground="{Binding MiniGameTempBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>

      <!-- Horizontal mode: 1 row -->
      <StackPanel x:Name="HorizontalContainer" Orientation="Horizontal" VerticalAlignment="Center">
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsFloatingVertical}" Value="True">
                <Setter Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding IsMiniGameHud}" Value="True">
                <Setter Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
        <!-- Drag handle -->
        <Border Width="3" Height="{Binding FontSize}" Background="#33FFFFFF" CornerRadius="1.5" Margin="0,0,8,0" VerticalAlignment="Center" />

        <!-- Metric Pods -->
        <ItemsControl ItemsSource="{Binding SystemPods}" VerticalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="Transparent" Padding="2,0" Margin="2,0"
                      MinWidth="{Binding MinWidth}"
                      Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}"
                      ToolTip="{Binding ToolTipText}">
                <TextBlock Text="{Binding ValueText}" Foreground="{Binding ForegroundBrush}"
                           FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Divider -->
        <Border Width="1" Height="{Binding FontSize}" Background="#26FFFFFF" Margin="6,0" VerticalAlignment="Center"
                Visibility="{Binding ShowDivider, Converter={StaticResource BoolToVis}}"/>

        <!-- Agent Pods -->
        <ItemsControl ItemsSource="{Binding AccountPods}" VerticalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="Transparent" Padding="2,0" Margin="2,0"
                      MinWidth="{Binding MinWidth}"
                      Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}"
                      ToolTip="{Binding ToolTipText}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                  <TextBlock Text="{Binding Label}" Foreground="{Binding StatusBrush}"
                             FontWeight="SemiBold" Margin="0,0,5,0" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding HorizontalValueText}" Foreground="#F0F4F8"
                             FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Vertical mode: 1 slim mini capsule column, upright sharp text -->
      <StackPanel x:Name="VerticalContainer" Orientation="Vertical" HorizontalAlignment="Center">
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsFloatingVertical}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding IsMiniGameHud}" Value="True">
                <Setter Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
        <!-- Drag handle at top -->
        <Border Height="2" Width="20" Background="#33FFFFFF" CornerRadius="1" Margin="0,0,0,5" HorizontalAlignment="Center" />

        <!-- Metric Pods (1 column) -->
        <ItemsControl ItemsSource="{Binding SystemPods}" HorizontalAlignment="Stretch">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="Transparent" Padding="0,1" Margin="0,1.5" HorizontalAlignment="Stretch"
                      Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}"
                      ToolTip="{Binding ToolTipText}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                  <TextBlock Text="{Binding Line1}" Foreground="{Binding ForegroundBrush}"
                             FontSize="{Binding DataContext.VerticalMetricFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                             FontWeight="SemiBold" HorizontalAlignment="Left" TextAlignment="Left"/>
                  <TextBlock Text="{Binding Line2}" Foreground="{Binding ForegroundBrush}"
                             FontSize="{Binding DataContext.VerticalMetricFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                             FontWeight="SemiBold" HorizontalAlignment="Left" TextAlignment="Left"
                             Visibility="{Binding HasLine2, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Divider -->
        <Border Height="1" Background="#20FFFFFF" Margin="0,4" HorizontalAlignment="Stretch" SnapsToDevicePixels="True"
                Visibility="{Binding ShowDivider, Converter={StaticResource BoolToVis}}"/>

        <!-- Agent Pods (1 column) -->
        <ItemsControl ItemsSource="{Binding AccountPods}" HorizontalAlignment="Stretch">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="Transparent" Padding="0,1" Margin="0,1.5" HorizontalAlignment="Stretch"
                      Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}"
                      ToolTip="{Binding ToolTipText}">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Line1}" Foreground="{Binding StatusBrush}"
                             FontSize="{Binding DataContext.VerticalAgentTitleFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                             FontWeight="SemiBold" HorizontalAlignment="Left" TextAlignment="Left" Margin="0,0,0,1"/>
                  <TextBlock Text="{Binding Line2}" Foreground="#F0F4F8"
                             FontSize="{Binding DataContext.VerticalMetricFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                             FontWeight="SemiBold" HorizontalAlignment="Left" TextAlignment="Left"/>
                  <TextBlock Text="{Binding Line3}" Foreground="#A0B0C4"
                             FontSize="{Binding DataContext.VerticalSubFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                             FontWeight="SemiBold" HorizontalAlignment="Left" TextAlignment="Left"
                             Visibility="{Binding Line3, Converter={StaticResource StringNotEmptyToVis}}"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Grid>
  </Border>
</Window>
