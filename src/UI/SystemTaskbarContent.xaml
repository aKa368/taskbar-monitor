<UserControl x:Class="TaskbarMonitor.UI.SystemTaskbarContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:TaskbarMonitor.UI"
             Background="Transparent" ClipToBounds="True"
             SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Grid Height="40" VerticalAlignment="Center" ClipToBounds="True">
    <ItemsControl ItemsSource="{Binding SystemPods}" ClipToBounds="True"
                  Margin="3,0,7,0" VerticalAlignment="Center" HorizontalAlignment="Stretch">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><ui:AdaptiveUniformPanel MaxRows="2" MinimumCellWidth="118" HorizontalGap="3" VerticalGap="2" PreferredSecondRowKey="network" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Background="#16000000" BorderBrush="#3DFFFFFF" BorderThickness="1"
                        CornerRadius="5" Padding="5,1" Height="18" ClipToBounds="True"
                        ToolTip="{Binding ToolTipText}">
                    <TextBlock Text="{Binding ValueText}" Foreground="#EEEEEE" FontSize="10"
                               FontFamily="{Binding DataContext.FontFamily, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
    </Grid>
</UserControl>
