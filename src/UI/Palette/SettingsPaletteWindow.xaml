<Window x:Class="TaskbarMonitor.UI.Palette.SettingsPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ui="clr-namespace:TaskbarMonitor.UI"
        xmlns:palette="clr-namespace:TaskbarMonitor.UI.Palette"
        mc:Ignorable="d"
        Title="TaskbarMonitor Settings"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnPreviewKeyDown"
        d:DesignWidth="520" d:DesignHeight="420">

    <Window.Resources>
        <!-- Must be declared before a template that resolves it at runtime. -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Command row: label + description + value -->
        <DataTemplate x:Key="CommandRowTemplate">
            <Border Background="Transparent" Padding="10,7" CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Active check -->
                    <TextBlock Grid.Column="0" Text="✓" Foreground="#4CAF50" FontSize="13" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,8,0"
                               Visibility="{Binding IsActiveValue, Converter={StaticResource BoolToVis}}" />

                    <!-- Label + description -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Label}" Foreground="#EEEEEE" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Description}" Foreground="#99FFFFFF" FontSize="11" />
                    </StackPanel>

                    <!-- Value text -->
                    <TextBlock Grid.Column="2" Text="{Binding ValueText}" Foreground="#77FFFFFF" FontSize="11"
                               VerticalAlignment="Center" Margin="8,0,0,0" />
                </Grid>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <!-- Dark overlay dim -->
    <Border Background="#66000000" Padding="40">
        <Border Background="#F01E1E1E"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                CornerRadius="8"
                Padding="0">
            <Grid Width="480" Height="400">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Search box -->
                <Border Grid.Row="0" Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                        CornerRadius="6" Margin="12,12,12,8" Padding="10,7">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔍" Foreground="#88FFFFFF" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="SearchBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" Foreground="White" FontSize="14"
                                 VerticalContentAlignment="Center" Width="380"
                                 ToolTip="Type a command or search…" />
                    </StackPanel>
                </Border>

                <!-- Results -->
                <ListBox x:Name="ResultsList"
                         Grid.Row="1"
                         ItemsSource="{Binding FilteredCommands}"
                         ItemTemplate="{StaticResource CommandRowTemplate}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="OnResultsMouseDoubleClick"
                         Margin="8,0,8,12">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#33FFFFFF" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- Explicit close affordance supplements Esc / Ctrl+W / Alt+F4. -->
                <DockPanel Grid.Row="2" LastChildFill="False" Margin="12,0,12,12">
                    <TextBlock DockPanel.Dock="Left" Text="Esc hoặc Ctrl+W để đóng" Foreground="#77FFFFFF"
                               FontSize="11" VerticalAlignment="Center" />
                    <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="Đóng" Padding="14,5"
                            IsCancel="True" Click="OnCloseClick" />
                </DockPanel>
            </Grid>
        </Border>
    </Border>
</Window>
